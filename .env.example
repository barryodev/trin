# ---------------------------------------------------------------------------
# Keystatic — production (GitHub storage) configuration
#
# Only needed when NODE_ENV=production, i.e. when deployed on Vercel.
# In local development Keystatic reads/writes files on disk directly and
# none of these are required.
#
# Setup steps live in README.md under "Keystatic in production".
# ---------------------------------------------------------------------------

# The GitHub repo Keystatic should read/write content from, e.g. "barry/personal-site"
KEYSTATIC_GITHUB_OWNER=your-github-username
KEYSTATIC_GITHUB_REPO=your-repo-name

# Credentials for the GitHub OAuth App that authenticates editors in the
# Keystatic admin UI (Settings > Developer settings > OAuth Apps on GitHub)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Random secret Keystatic uses to encrypt the editor's session cookie.
# Generate one with: openssl rand -base64 32
KEYSTATIC_SECRET=
